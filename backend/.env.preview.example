# Vami Preview Environment configuration (Vercel/Railway/Render)
NODE_ENV=preview
PORT=5000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vami_preview
REDIS_URI=rediss://<user>:<password>@<host>:<port>

# Security
JWT_ACCESS_SECRET=preview_access_secret_needs_to_be_32_chars_long
JWT_REFRESH_SECRET=preview_refresh_secret_needs_to_be_32_chars_long
COOKIE_SECRET=preview_cookie_secret_needs_to_be_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & URLs
CORS_ORIGIN=https://vami-preview.vercel.app
APP_URL=https://vami-preview.vercel.app

# Features
REQUIRE_EMAIL_VERIFICATION=false
