# Environment Mode: development | preview | production
NODE_ENV=development
PORT=5000

# Database Connections (Free-Tier Ready)
# Local Docker: mongodb://127.0.0.1:27017/vami_db
# MongoDB Atlas Free Tier: mongodb+srv://<user>:<password>@cluster0.mongodb.net/vami_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/vami_db

# Redis Pub/Sub & Presence (Free-Tier Ready)
# Local Docker: redis://127.0.0.1:6379
# Upstash Redis Free Tier: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URI=redis://127.0.0.1:6379

# Authentication & Tokens
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32chars_min
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars

# CORS & URLs
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Features
REQUIRE_EMAIL_VERIFICATION=false

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get a free API key at https://resend.com (3,000 emails/month, 100/day)
# Local dev: Leave RESEND_API_KEY unset — tokens are logged to console instead.
# Preview/Prod: Set RESEND_API_KEY and point EMAIL_FROM at your verified domain.
#
# Local testing without a real inbox: use Resend's built-in test addresses:
#   delivered@resend.dev  → simulates successful delivery
#   bounced@resend.dev    → simulates a hard bounce
#   complained@resend.dev → simulates a spam complaint
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
